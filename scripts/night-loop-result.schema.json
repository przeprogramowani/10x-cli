{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["changed", "no_change", "blocked"]
    },
    "kind": {
      "type": "string",
      "enum": ["lint"]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "commit_message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "metric": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "evidence": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "status",
    "kind",
    "title",
    "commit_message",
    "summary",
    "metric",
    "evidence"
  ]
}
